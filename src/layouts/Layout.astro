---
import '../styles/global.css'
import { ClientRouter } from 'astro:transitions'
import Background from '@shared/ui/Background.astro'
import Sidebar from '@shared/ui/navigation/Sidebar.astro'
import { Font } from 'astro:assets'

interface Props {
  title?: string
  description?: string
  class?: string
}

const {
  title = 'Cartografías Sensoriales',
  description = 'Plataforma de mapeo de marcas sonoras',
  class: bodyClass = ''
} = Astro.props
const path = Astro.url.pathname
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <Font cssVariable="--font-inter" />
    <Font cssVariable="--font-cormorant" />
    <ClientRouter />
  </head>
  <body class=`bg-charcoal font-inter relative flex min-h-dvh z-0 ${bodyClass}`>
    <Background />
    {path === '/' ? null : <Sidebar />}
    <slot />
  </body>
</html>

<script>
  import { installHoverPreviewController } from '@features/maps/ui/hoverPreviewController'

  installHoverPreviewController()
</script>
