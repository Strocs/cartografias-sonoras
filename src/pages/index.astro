---
import Layout from '../layouts/Layout.astro';
import MapCard from '../features/maps/ui/MapCard.astro';
import { MAPS_DATA } from '../features/maps/data/maps';

const title = 'Cartografías Sensoriales';
---

<Layout title={title}>
  <main class="flex-1 p-4 md:p-4" transition:animate="fade">
    <section aria-label="Cartografías" class="">
      <div class="grid grid-cols-1 gap-4 bg-red-200 md:grid-cols-3">
        {
          MAPS_DATA.map((map, index) => {
            const isAboveFold = index < 2;
            return (
              <MapCard map={map} loading={isAboveFold ? 'eager' : 'lazy'} />
            );
          })
        }
      </div>
    </section>
  </main>
</Layout>
