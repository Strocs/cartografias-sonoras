---
import Layout from '../layouts/Layout.astro'
import MapCard from '../features/maps/ui/MapCard.astro'
import { MAPS_DATA } from '../features/maps/data/maps'

import anidLogo from '@assets/logos/anid.png'
import innovaLogo from '@assets/logos/innova.png'
import arqulsLogo from '@assets/logos/arquls.png'
import { Image, Picture } from 'astro:assets'
import siteIcon from '@assets/site/icon.png'
import separator from '@assets/site/separator.png'

const title = 'Cartografías Sensoriales'
---

<Layout title={title} class="flex-col justify-between gap-6">
  <header class="container mx-auto flex flex-col items-center gap-1 px-4 pt-4">
    <Image
      src={siteIcon}
      width={siteIcon.width}
      height={siteIcon.height}
      alt="Logo de Cartografías Sensoriales"
      class="aspect-auto max-h-24 w-fit"
      loading="eager"
      widths={[128, 320]}
    />
    <h1
      class="max-w-2xl text-center font-cormorant text-4xl leading-none tracking-wide text-secondary-sand uppercase md:text-7xl"
    >
      Cartografías Sensoriales
    </h1>
    <span class="mx-auto text-center font-inter leading-none font-extralight tracking-widest text-canvas">
      Mapeo de Marcas Sonoras en la Región de Coquimbo
    </span>
  </header>
  <main class="container mx-auto space-y-8 p-4" transition:animate="fade">
    <h3 class="text-center font-light text-secondary-sand">
      Explora las rutas y sus paisajes sonoros
      <span class="block text-sm font-light text-secondary-sand/80">Se recomienda el uso de audífonos</span>
    </h3>
    <section aria-label="Cartografías">
      <div class="mx-auto grid grid-cols-1 gap-8 md:grid-cols-3 md:gap-4">
        <Image
          src={separator}
          width={separator.width}
          height={separator.height}
          alt=""
          class="-mb-4 h-fit w-full pt-4 md:hidden"
          aria-hidden="true"
        />
        {
          MAPS_DATA.map((map) => {
            return (
              <div>
                <MapCard map={map} loading="eager" />
                <Image
                  src={separator}
                  width={separator.width}
                  height={separator.height}
                  alt=""
                  class="h-fit w-full pt-8 md:hidden"
                  aria-hidden="true"
                />
              </div>
            )
          })
        }
      </div>
    </section>
  </main>
  <footer class="mx-auto px-4 pb-4">
    <span class="mx-auto block text-center text-sm font-light text-secondary-sand">Financian: </span>
    <div class="border-secondary-sand/20">
      <div class="mx-auto flex w-full flex-wrap items-center justify-center gap-6 pt-6">
        <Picture
          src={anidLogo}
          formats={['avif', 'webp']}
          fallbackFormat="png"
          alt="Logo de la Agencia Nacional de Investigación y Desarrollo (ANID)"
          loading="eager"
          class="aspect-auto max-h-18 w-full"
        />
        <Picture
          src={innovaLogo}
          formats={['avif', 'webp']}
          fallbackFormat="png"
          alt="Logo de Innova USerena"
          loading="eager"
          class="aspect-auto max-h-18 w-full"
        />
        <Picture
          src={arqulsLogo}
          formats={['avif', 'webp']}
          fallbackFormat="png"
          alt="Logo de la Escuela de Arquitectura de la Universidad de La Serena"
          loading="eager"
          class="aspect-auto max-h-24 w-full"
        />
      </div>
    </div>
  </footer>
</Layout>
