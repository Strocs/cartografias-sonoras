---
import Layout from '../layouts/Layout.astro';
import { siteContent } from '../shared/data/site-content';

const { team } = siteContent;
---

<Layout title={team.title} description={team.description}>
  <main class="flex-1 p-6 md:p-8">
    <h1 class="text-primary-navy text-3xl font-bold">{team.heading}</h1>
    <p class="text-primary-brown mt-2 max-w-2xl">{team.description}</p>
    <div class="text-primary-brown mt-6 max-w-3xl space-y-4">
      {team.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </main>
</Layout>
