---
import Layout from '../layouts/Layout.astro'
import { Image } from 'astro:assets'
import separator from '@assets/site/separator.png'
import { siteContent } from '@shared/data/site-content'
import { teamMembers } from '@shared/data/team'

const { team } = siteContent
---

<Layout title={team.title} description={team.description}>
  <main class="mx-auto min-w-0 flex-1 px-6 py-20 md:px-8 md:py-12 lg:px-12">
    <header class="mb-12">
      <h1 class="font-cormorant text-5xl leading-tight font-bold text-secondary-sand md:text-6xl">{team.heading}</h1>
    </header>
    <section aria-label="Integrantes del equipo" class="grid grid-cols-1 gap-x-12 gap-y-10 xl:grid-cols-2">
      {
        teamMembers.map((member) => (
          <article class="min-w-0">
            <Image src={separator} alt="" aria-hidden="true" class="mb-6 h-auto w-full max-w-80" />
            <h2 class="max-w-xl font-cormorant text-3xl leading-tight text-secondary-sand md:text-4xl">
              {member.name}
            </h2>
            <p class="mt-3 text-sm leading-relaxed font-medium text-secondary-sand">{member.role}</p>
            <p class="mt-5 max-w-prose text-base leading-relaxed text-canvas">{member.biography}</p>
            {member.email && (
              <a
                href={`mailto:${member.email}`}
                class="mt-5 inline-block break-all text-secondary-sand underline underline-offset-4 hover:text-canvas focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary-sand"
              >
                {member.email}
              </a>
            )}
          </article>
        ))
      }
    </section>
  </main>
</Layout>
