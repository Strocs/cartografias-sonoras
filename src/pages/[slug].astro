---
import Layout from '../layouts/Layout.astro';
import MapPage from '../views/map/MapPage.astro';
import { MAPS_DATA } from '../features/maps/data/maps';
import { mockSounds } from '../features/sounds/data/mock-sounds';
import { mockPaths } from '../features/paths/data/mock-paths';
import { mockSoundPieces } from '../features/sound-pieces/data/mock-sound-pieces';

export function getStaticPaths() {
  return MAPS_DATA.map((map) => ({ params: { slug: map.slug } }));
}

const { slug } = Astro.params;
const map = MAPS_DATA.find((m) => m.slug === slug);

if (!map) {
  return new Response('Not found', { status: 404 });
}

const sounds = mockSounds.filter((sound) => sound.mapId === map.id);
const paths = mockPaths.filter((path) => path.mapId === map.id);
const soundPiece =
  mockSoundPieces.find((piece) => piece.mapId === map.id) ?? null;
---

<Layout title={map.title}>
  <MapPage
    map={map}
    maps={MAPS_DATA}
    sounds={sounds}
    paths={paths}
    soundPiece={soundPiece}
  />
</Layout>
