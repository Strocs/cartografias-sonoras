---
import Layout from '../layouts/Layout.astro'
import { siteContent } from '../shared/data/site-content'

const { data } = siteContent
---

<Layout title={data.title} description={data.description}>
  <main class="flex-1 p-6 md:p-8">
    <h1 class="text-primary-navy text-3xl font-bold">{data.heading}</h1>
    <p class="text-primary-brown mt-2 max-w-2xl">{data.description}</p>
    <div class="text-primary-brown mt-6 max-w-3xl space-y-4">
      {data.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </main>
</Layout>
