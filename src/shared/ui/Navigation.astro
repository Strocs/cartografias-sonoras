---
import { Picture } from 'astro:assets';

import anidLogo from '../../assets/logos/anid.png';
import innovaLogo from '../../assets/logos/innova.png';
import arqulsLogo from '../../assets/logos/arquls.png';

const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Inicio', icon: 'home' },
  { href: '/proyecto', label: 'Proyecto', icon: 'document' },
  { href: '/datos', label: 'Datos', icon: 'map' },
  { href: '/equipo', label: 'Equipo', icon: 'people' }
] as const;
---

<aside class="md:w-62 md:shrink-0 md:p-4">
  <button
    data-nav-toggle
    type="button"
    aria-controls="nav-panel"
    aria-expanded="false"
    aria-label="Abrir menú de navegación"
    class="bg-primary-teal text-canvas hover:bg-primary-navy focus-visible:ring-primary-teal fixed top-4 left-4 z-[1080] flex h-11 w-11 items-center justify-center rounded-lg shadow-lg transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none md:hidden"
  >
    <svg
      aria-hidden="true"
      class="h-5 w-5"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <line x1="3" y1="12" x2="21" y2="12"></line>
      <line x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
  </button>

  <div
    data-nav-backdrop
    aria-hidden="true"
    class="bg-charcoal/40 pointer-events-none fixed inset-0 z-[1090] opacity-0 transition-opacity duration-300 motion-reduce:transition-none md:hidden"
  >
  </div>

  <div
    id="nav-panel"
    data-nav-panel
    class="border-secondary-sand/60 bg-canvas fixed inset-y-0 left-0 z-[1100] flex w-72 max-w-[85vw] -translate-x-full flex-col rounded-r-xl border shadow-lg transition-transform duration-300 motion-reduce:transition-none md:static md:z-auto md:h-full md:w-auto md:max-w-none md:translate-x-0 md:rounded-xl md:transition-none"
  >
    <div class="flex items-start justify-between gap-4 p-6 pb-4">
      <a href="/" class="flex flex-col gap-1">
        <span
          class="text-primary-brown font-serif text-lg leading-none font-black tracking-wide uppercase"
        >
          Cartografías Sensoriales
        </span>
        <span class="text-secondary-sand text-xs tracking-widest lowercase">
          Mapeo de Marcas Sonoras
        </span>
      </a>
      <button
        data-nav-close
        type="button"
        aria-label="Cerrar menú"
        class="bg-secondary-sand/20 text-primary-navy hover:bg-secondary-sand/30 focus-visible:ring-primary-teal -mt-1 -mr-2 flex h-9 w-9 shrink-0 items-center justify-center rounded-md transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none md:hidden"
      >
        <svg
          aria-hidden="true"
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <nav aria-label="Principal" class="flex-1 px-2 py-2">
      <ul class="flex flex-col gap-1">
        {
          navItems.map((item) => {
            const isActive =
              currentPath === item.href ||
              (item.href !== '/' && currentPath.startsWith(item.href));

            return (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive ? 'page' : undefined}
                  class:list={[
                    'flex items-center gap-3 rounded-md px-3 py-2 text-sm transition-colors',
                    isActive
                      ? 'border-primary-teal bg-primary-teal/5 text-charcoal border-l-4'
                      : 'text-primary-brown hover:bg-secondary-sand/20 hover:text-charcoal'
                  ]}
                >
                  {item.icon === 'home' && (
                    <svg
                      aria-hidden="true"
                      class="h-5 w-5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                      <polyline points="9 22 9 12 15 12 15 22" />
                    </svg>
                  )}
                  {item.icon === 'document' && (
                    <svg
                      aria-hidden="true"
                      class="h-5 w-5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                      <polyline points="14 2 14 8 20 8" />
                      <line x1="16" y1="13" x2="8" y2="13" />
                      <line x1="16" y1="17" x2="8" y2="17" />
                      <polyline points="10 9 9 9 8 9" />
                    </svg>
                  )}
                  {item.icon === 'map' && (
                    <svg
                      aria-hidden="true"
                      class="h-5 w-5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polygon points="1 6 1 22 8 18 16 22 21 18 21 2 16 6 8 2 1 6" />
                      <line x1="8" y1="2" x2="8" y2="18" />
                      <line x1="16" y1="6" x2="16" y2="22" />
                    </svg>
                  )}
                  {item.icon === 'people' && (
                    <svg
                      aria-hidden="true"
                      class="h-5 w-5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                      <circle cx="9" cy="7" r="4" />
                      <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                      <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                  )}
                  <span>{item.label}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <footer class="mt-auto p-6">
      <div class="mb-12">
        <p class="text-charcoal/50 text-sm">
          Navega por los mapas sonoros, reproduce los sonidos o la obra
          compuesta para esta área.
        </p>
      </div>
      <div class="border-secondary-sand/20 border-t pt-4">
        <div class="mx-auto flex w-full max-w-32 flex-col items-center gap-1">
          <Picture
            src={anidLogo}
            formats={['avif', 'webp']}
            fallbackFormat="png"
            alt="ANID"
            class="aspect-auto w-full"
          />
          <Picture
            src={innovaLogo}
            formats={['avif', 'webp']}
            fallbackFormat="png"
            alt="Innova"
            class="aspect-auto invert"
          />
          <Picture
            src={arqulsLogo}
            formats={['avif', 'webp']}
            fallbackFormat="png"
            alt="ARQULS"
            class="aspect-auto w-25"
          />
        </div>
      </div>
    </footer>
  </div>
</aside>

<script>
  const DESKTOP_MQ = window.matchMedia('(min-width: 48rem)');

  const nav = {
    panel: null as HTMLElement | null,
    toggle: null as HTMLElement | null,
    backdrop: null as HTMLElement | null,
    open: false
  };

  function readNav(): void {
    nav.panel = document.querySelector('[data-nav-panel]');
    nav.toggle = document.querySelector('[data-nav-toggle]');
    nav.backdrop = document.querySelector('[data-nav-backdrop]');
  }

  function setMenu(open: boolean, restoreFocus = true): void {
    if (!nav.panel) return;

    const closeMobile = (): void => {
      nav.panel?.classList.remove('translate-x-0');
      nav.panel?.classList.add('-translate-x-full');
      nav.panel?.setAttribute('inert', '');
      nav.panel?.setAttribute('aria-hidden', 'true');
      nav.backdrop?.classList.remove('pointer-events-auto', 'opacity-100');
      nav.toggle?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    };

    if (DESKTOP_MQ.matches) {
      nav.open = false;
      closeMobile();
      nav.panel.removeAttribute('inert');
      nav.panel.removeAttribute('aria-hidden');
      return;
    }

    if (open && nav.open) return;
    nav.open = open;

    if (open) {
      nav.panel.classList.add('translate-x-0');
      nav.panel.classList.remove('-translate-x-full');
      nav.panel.removeAttribute('inert');
      nav.panel.removeAttribute('aria-hidden');
      nav.backdrop?.classList.add('pointer-events-auto', 'opacity-100');
      nav.toggle?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => {
        const firstFocusable =
          nav.panel?.querySelector<HTMLElement>('[data-nav-close]') ??
          nav.panel?.querySelector<HTMLElement>('a, button');
        (firstFocusable ?? nav.toggle)?.focus();
      });
    } else {
      closeMobile();
      if (restoreFocus && nav.toggle && nav.toggle.offsetWidth > 0) {
        nav.toggle.focus();
      }
    }
  }

  function initNavigation(): void {
    readNav();
    setMenu(false, false);
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target.closest('[data-nav-toggle]')) {
      setMenu(true);
    } else if (target.closest('[data-nav-close]')) {
      setMenu(false);
    } else if (target.closest('[data-nav-panel] a')) {
      setMenu(false, false);
    } else if (target.closest('[data-nav-backdrop]')) {
      setMenu(false);
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && nav.open) {
      setMenu(false);
      return;
    }

    if (event.key === 'Tab' && nav.open && nav.panel) {
      const focusables = Array.from(
        nav.panel.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])'
        )
      );
      if (focusables.length === 0) return;

      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      const active = document.activeElement;

      if (event.shiftKey && (active === first || !nav.panel.contains(active))) {
        event.preventDefault();
        last.focus();
      } else if (
        !event.shiftKey &&
        (active === last || !nav.panel.contains(active))
      ) {
        event.preventDefault();
        first.focus();
      }
    }
  });

  DESKTOP_MQ.addEventListener('change', () => setMenu(false, false));
  document.addEventListener('astro:page-load', initNavigation);

  initNavigation();
</script>
