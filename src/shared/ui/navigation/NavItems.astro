---
const currentPath = Astro.url.pathname

const navItems = [
  { href: '/', label: 'Inicio', icon: 'home' }
  // { href: '/proyecto', label: 'Proyecto', icon: 'document' },
  // { href: '/datos', label: 'Datos', icon: 'map' },
  // { href: '/equipo', label: 'Equipo', icon: 'people' }
] as const
---

<nav aria-label="Principal" class="flex-1 p-2">
  <ul class="flex flex-col gap-1">
    {
      navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))

        return (
          <li>
            <a
              href={item.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'flex items-center gap-3 rounded-md px-3 py-2 text-sm text-secondary-sand transition-colors',
                isActive ? 'bg-primary-teal/40' : 'hover:bg-primary-teal/40'
              ]}
            >
              {item.icon === 'home' && (
                <svg
                  aria-hidden="true"
                  class="h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                  <polyline points="9 22 9 12 15 12 15 22" />
                </svg>
              )}
              <span>{item.label}</span>
            </a>
          </li>
        )
      })
    }
  </ul>
</nav>
