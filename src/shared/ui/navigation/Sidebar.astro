---
import { Picture } from 'astro:assets'

import anidLogo from '@assets/logos/anid.png'
import innovaLogo from '@assets/logos/innova.png'
import arqulsLogo from '@assets/logos/arquls.png'
import NavItems from './NavItems.astro'
---

<aside class="md:pointer-events-none md:relative md:z-10 md:max-h-dvh md:w-62 md:shrink-0 md:p-4">
  <button
    data-nav-toggle
    type="button"
    aria-controls="nav-panel"
    aria-expanded="false"
    aria-label="Abrir menú de navegación"
    class="fixed top-4 left-4 z-1080 flex h-11 w-11 items-center justify-center rounded-lg bg-primary-teal text-secondary-sand shadow-lg transition-colors hover:bg-primary-navy focus-visible:ring-2 focus-visible:ring-primary-teal focus-visible:ring-offset-2 focus-visible:outline-none md:hidden"
  >
    <svg
      aria-hidden="true"
      class="h-5 w-5"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <line x1="3" y1="12" x2="21" y2="12"></line>
      <line x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
  </button>

  <div
    data-nav-backdrop
    aria-hidden="true"
    class="pointer-events-none fixed inset-0 z-1090 bg-charcoal/40 opacity-0 transition-opacity duration-300 motion-reduce:transition-none md:hidden"
  >
  </div>

  <div
    id="nav-panel"
    data-nav-panel
    class="fixed inset-y-2 left-0 z-1100 flex w-72 max-w-[85vw] -translate-x-full flex-col rounded-r-xl border border-l-0 border-secondary-sand bg-charcoal shadow-lg transition-transform duration-300 motion-reduce:transition-none md:pointer-events-auto md:static md:z-auto md:h-full md:w-auto md:max-w-none md:translate-x-0 md:rounded-xl md:border-l md:transition-none"
  >
    <div class="flex items-start justify-between gap-4 p-6 pb-4">
      <a href="/" class="flex flex-col gap-1">
        <h1 class="font-cormorant text-xl leading-none font-bold tracking-wide text-secondary-sand uppercase">
          Cartografías Sensoriales
        </h1>
        <span class="text-xs leading-none tracking-widest text-secondary-blue/60"> Mapeo de Marcas Sonoras </span>
      </a>
      <button
        data-nav-close
        type="button"
        aria-label="Cerrar menú"
        class="-mt-1 -mr-2 flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-primary-teal text-secondary-sand transition-colors hover:bg-secondary-sand/30 focus-visible:ring-2 focus-visible:ring-primary-teal focus-visible:ring-offset-2 focus-visible:outline-none md:hidden"
      >
        <svg
          aria-hidden="true"
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <NavItems />

    <footer class="mt-auto px-4 py-6">
      <div class="mb-6">
        <p class="text-center font-cormorant leading-tight text-secondary-sand/80">
          Explora las tres rutas y reproduce los paisajes sonoros.
        </p>
      </div>
      <div class="border-t border-secondary-sand/20">
        <div class="mx-auto flex w-full flex-col items-center gap-2 pt-6">
          <Picture
            src={anidLogo}
            formats={['avif', 'webp']}
            fallbackFormat="png"
            alt="Logo de la Agencia Nacional de Investigación y Desarrollo (ANID)"
            loading="eager"
            class="aspect-auto w-full"
          />
          <div class="flex w-full items-center justify-center">
            <Picture
              src={innovaLogo}
              formats={['avif', 'webp']}
              fallbackFormat="png"
              alt="Logo de Innova USerena"
              loading="eager"
              class="aspect-auto"
            />
            <Picture
              src={arqulsLogo}
              formats={['avif', 'webp']}
              fallbackFormat="png"
              alt="Logo de la Escuela de Arquitectura de la Universidad de La Serena"
              loading="eager"
              class="aspect-auto max-w-20"
            />
          </div>
        </div>
      </div>
    </footer>
  </div>
</aside>

<script>
  const DESKTOP_MQ = window.matchMedia('(min-width: 48rem)')

  const nav = {
    panel: null as HTMLElement | null,
    toggle: null as HTMLElement | null,
    backdrop: null as HTMLElement | null,
    open: false
  }

  function readNav(): void {
    nav.panel = document.querySelector('[data-nav-panel]')
    nav.toggle = document.querySelector('[data-nav-toggle]')
    nav.backdrop = document.querySelector('[data-nav-backdrop]')
  }

  function setMenu(open: boolean, restoreFocus = true): void {
    if (!nav.panel) return

    const closeMobile = (): void => {
      nav.panel?.classList.remove('translate-x-0')
      nav.panel?.classList.add('-translate-x-full')
      nav.panel?.setAttribute('inert', '')
      nav.panel?.setAttribute('aria-hidden', 'true')
      nav.backdrop?.classList.remove('pointer-events-auto', 'opacity-100')
      nav.toggle?.setAttribute('aria-expanded', 'false')
      document.body.style.overflow = ''
    }

    if (DESKTOP_MQ.matches) {
      nav.open = false
      closeMobile()
      nav.panel.removeAttribute('inert')
      nav.panel.removeAttribute('aria-hidden')
      return
    }

    if (open && nav.open) return
    nav.open = open

    if (open) {
      nav.panel.classList.add('translate-x-0')
      nav.panel.classList.remove('-translate-x-full')
      nav.panel.removeAttribute('inert')
      nav.panel.removeAttribute('aria-hidden')
      nav.backdrop?.classList.add('pointer-events-auto', 'opacity-100')
      nav.toggle?.setAttribute('aria-expanded', 'true')
      document.body.style.overflow = 'hidden'
      requestAnimationFrame(() => {
        const firstFocusable =
          nav.panel?.querySelector<HTMLElement>('[data-nav-close]') ??
          nav.panel?.querySelector<HTMLElement>('a, button')
        ;(firstFocusable ?? nav.toggle)?.focus()
      })
    } else {
      closeMobile()
      if (restoreFocus && nav.toggle && nav.toggle.offsetWidth > 0) {
        nav.toggle.focus()
      }
    }
  }

  function initSidebar(): void {
    readNav()
    setMenu(false, false)
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement
    if (target.closest('[data-nav-toggle]')) {
      setMenu(true)
    } else if (target.closest('[data-nav-close]')) {
      setMenu(false)
    } else if (target.closest('[data-nav-panel] a')) {
      setMenu(false, false)
    } else if (target.closest('[data-nav-backdrop]')) {
      setMenu(false)
    }
  })

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && nav.open) {
      setMenu(false)
      return
    }

    if (event.key === 'Tab' && nav.open && nav.panel) {
      const focusables = Array.from(
        nav.panel.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])'
        )
      )
      if (focusables.length === 0) return

      const first = focusables[0]
      const last = focusables[focusables.length - 1]
      const active = document.activeElement

      if (event.shiftKey && (active === first || !nav.panel.contains(active))) {
        event.preventDefault()
        last.focus()
      } else if (!event.shiftKey && (active === last || !nav.panel.contains(active))) {
        event.preventDefault()
        first.focus()
      }
    }
  })

  DESKTOP_MQ.addEventListener('change', () => setMenu(false, false))
  document.addEventListener('astro:page-load', initSidebar)

  initSidebar()
</script>
