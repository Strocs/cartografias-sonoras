---
import { Image } from 'astro:assets'

import type { Map } from '../domain/types'
import type { DestinationPreview } from '../lib/destinationPreview'

interface Props {
  map: Map
  loading?: 'eager' | 'lazy'
  class?: string
  imageClass?: string
  /** Responsive candidate widths for the generated `srcset`. */
  widths?: number[]
  /** The container's rendered width, so the browser picks the right candidate. */
  sizes?: string
  destinationPreview?: DestinationPreview
  transitionRole?: 'source' | 'destination'
}

const {
  map,
  loading = 'lazy',
  class: className = '',
  imageClass = '',
  widths = [640, 960, 1280, 1600],
  sizes = '100vw',
  destinationPreview,
  transitionRole = 'source'
} = Astro.props

const labelId = `map-composition-label-${map.slug}`
const isDestination = transitionRole === 'destination'
---

<figure
  class={isDestination ? `${className} map-composition-destination` : className}
  aria-labelledby={labelId}
  transition:name={!isDestination ? `map-composition-${map.slug}` : undefined}
  data-map-composition-preview
>
  {
    destinationPreview ? (
      <Image
        src={destinationPreview.src}
        srcset={destinationPreview.srcset}
        sizes={destinationPreview.sizes}
        alt={map.title}
        aria-hidden="true"
        class={isDestination ? `map-composition-destination-image ${imageClass}` : imageClass}
        loading={loading}
        width={destinationPreview.width}
        height={destinationPreview.height}
        transition:name={isDestination ? `map-composition-${map.slug}` : undefined}
        {...(loading === 'eager' ? { fetchpriority: 'high' } : {})}
      />
    ) : (
      <Image
        src={map.preview.asset!}
        alt={map.title}
        aria-hidden="true"
        class={imageClass}
        loading={loading}
        width={map.preview.width}
        height={map.preview.height}
        widths={widths}
        sizes={sizes}
        transition:name={isDestination ? `map-composition-${map.slug}` : undefined}
        {...(loading === 'eager' ? { fetchpriority: 'high' } : {})}
      />
    )
  }
  <figcaption id={labelId} class="sr-only">{map.title}</figcaption>
</figure>

<style>
  [data-map-composition-preview].map-composition-destination {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  [data-map-composition-preview] :global(.map-composition-destination-image) {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
</style>
