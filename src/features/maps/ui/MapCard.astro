---
import MapCompositionPreview from './MapCompositionPreview.astro'

import type { Map } from '../domain/types'

interface Props {
  map: Map
  loading?: 'eager' | 'lazy'
}

const { map, loading = 'lazy' } = Astro.props
---

<a
  href={`/${map.slug}`}
  class="group border-secondary-sand bg-charcoal relative block h-full overflow-hidden rounded-xl border-2 shadow-lg"
  data-testid="map-card"
>
  <h2
    class="text-secondary-sand absolute top-4 right-0 left-0 z-10 mx-auto block px-4 text-center text-4xl font-bold"
    transition:name={`map-title-${map.slug}`}
  >
    {map.title}
  </h2>
  <MapCompositionPreview
    map={map}
    loading={loading}
    class="h-full w-full"
    imageClass="h-full w-full object-contain transition-transform duration-600 group-hover:scale-140"
    widths={[360, 540, 720, 960]}
    sizes="(min-width: 768px) 33vw, 92vw"
  />
</a>
