---
import { Picture } from 'astro:assets';

import type { Map } from '../domain/types';

interface Props {
  map: Map;
  loading?: 'eager' | 'lazy';
}

const { map, loading = 'lazy' } = Astro.props;

const widths = [400, 800, 1200];
const sizes = '(max-width: 767px) 50vw, 33vw';
---

<a
  href={`/${map.slug}`}
  class="group border-secondary-sand/60 bg-canvas relative h-full overflow-hidden rounded-xl border shadow-lg"
  data-testid="map-card"
>
  <h2
    class="text-primary-navy group-hover:text-primary-brown absolute z-10 text-lg font-semibold"
    transition:name={`map-title-${map.slug}`}
  >
    {map.title}
  </h2>
  {
    map.image.asset ? (
      <Picture
        src={map.image.asset}
        formats={['avif', 'webp']}
        fallbackFormat="png"
        widths={widths}
        sizes={sizes}
        alt={map.title}
        loading={loading}
        width={map.image.width}
        height={map.image.height}
        class="h-full w-full object-contain transition-transform duration-600 group-hover:scale-140"
        transition:name={`map-thumb-${map.slug}`}
        {...(loading === 'eager' ? { fetchpriority: 'high' } : {})}
      />
    ) : (
      <img
        src={map.image.src}
        alt={map.title}
        class="h-full w-full object-contain transition-transform duration-600 group-hover:scale-140"
        transition:name={`map-thumb-${map.slug}`}
        loading={loading}
        width={map.image.width}
        height={map.image.height}
        {...(loading === 'eager' ? { fetchpriority: 'high' } : {})}
      />
    )
  }
</a>
