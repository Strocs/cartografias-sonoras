---
import MapCompositionPreview from './MapCompositionPreview.astro'
import { getMapDestinationPreview } from '../lib/destinationPreview'

import type { Map } from '../domain/types'

interface Props {
  maps: Map[]
  activeSlug: string
  class?: string
}

const { maps, activeSlug, class: className } = Astro.props
const inactiveMaps = await Promise.all(
  maps
    .filter((map) => map.slug !== activeSlug)
    .map(async (map) => ({ map, destinationPreview: await getMapDestinationPreview(map) }))
)
---

<aside
  class={`absolute right-0 bottom-0 left-0 z-100 h-32 w-full shrink-0 px-4 py-4 md:relative md:h-full md:w-36 md:max-h-dvh md:px-0 md:pr-4 md:pointer-events-none ${className ?? ''}`}
  data-testid="right-rail"
>
  <div class="flex h-full flex-row gap-4 overflow-x-auto md:flex-col md:overflow-visible">
    {
      inactiveMaps.map(({ map, destinationPreview }) => (
        <a
          href={`/${map.slug}`}
          class="group relative flex h-full flex-1 flex-col overflow-hidden rounded-xl border border-secondary-sand bg-charcoal shadow-lg md:pointer-events-auto"
          data-rail-card
          data-preview-src={destinationPreview.src}
          data-preview-srcset={destinationPreview.srcset}
          data-preview-sizes={destinationPreview.sizes}
        >
          <div
            class="absolute inset-0 z-10 flex items-center justify-center p-2 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
            data-rail-title
          >
            <span class="block text-center font-cormorant text-lg leading-none font-bold tracking-wide text-white uppercase">
              {map.title}
            </span>
          </div>
          <MapCompositionPreview
            map={map}
            loading="eager"
            class="size-full"
            imageClass="size-full object-cover transition-all duration-300 group-hover:scale-105 group-hover:grayscale-0 grayscale-100 group-hover:blur-sm"
            widths={[620]}
            sizes="(min-width: 768px) 9rem, 7rem"
          />
        </a>
      ))
    }
  </div>
</aside>

<script>
  document.querySelectorAll<HTMLElement>('[data-rail-card]').forEach((card) => {
    const image = card.querySelector<HTMLElement>('[data-map-composition-preview] img')
    const title = card.querySelector<HTMLElement>('[data-rail-title]')

    card.addEventListener('mouseenter', () => {
      if (image) image.style.transform = 'scale(1.02)'
      if (title) title.style.opacity = '1'
    })

    card.addEventListener('mouseleave', () => {
      if (image) image.style.transform = ''
      if (title) title.style.opacity = ''
    })
  })
</script>
