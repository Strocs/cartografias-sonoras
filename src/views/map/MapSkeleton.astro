---
/**
 * Skeleton loader shown while the client:only MapCanvas React island
 * initializes the Leaflet viewport. Prevents the RightRail from
 * shifting left during SSR by occupying flex-1 space in the layout.
 *
 * Hidden via CSS `:has(.leaflet-container)` once the map renders.
 */
---

<div
  class="map-skeleton pointer-events-none absolute inset-0 z-10 flex items-center justify-center pt-4 pr-4 pb-20 transition-opacity duration-300"
>
  <div
    class="bg-charcoal/5 flex size-full animate-pulse flex-col items-center justify-center rounded-xl"
  >
    <!--
version: "2.34"
unicode: "fc79"
-->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="32"
      height="32"
      viewBox="0 0 24 24"
      fill="none"
      stroke-width="1"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="stroke-charcoal/10 size-60"
    >
      <path d="M3 7l6 -3l6 3l6 -3v13l-6 3l-6 -3l-6 3v-13"></path>
      <path d="M9 12v.01"></path>
      <path d="M6 13v.01"></path>
      <path d="M17 15l-4 -4"></path>
      <path d="M13 15l4 -4"></path>
    </svg>
  </div>
</div>
