---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../shared/ui/Navigation.astro';
import RightRail from '../../features/maps/ui/RightRail.astro';
import MapSkeleton from './MapSkeleton.astro';
import { AudioPool } from '../../shared/lib/audio-engine';
import { AudioBottomPlayer } from '../../features/sound-pieces/ui/AudioBottomPlayer.tsx';
import { MapControls } from '../../features/maps/ui/MapControls.tsx';

import '../../features/sounds/ui/marker-styles.css';
import '../../features/paths/styles/path-styles.css';

import type { Map } from '../../features/maps/domain/types';
import type { Sound } from '../../features/sounds/domain/types';
import type { Path } from '../../features/paths/domain/types';
import type { SoundPiece } from '../../features/sound-pieces/domain/types';

interface Props {
  map: Map;
  maps: Map[];
  sounds: Sound[];
  paths: Path[];
  soundPiece?: SoundPiece | null;
}

const { map, maps, sounds, paths, soundPiece } = Astro.props;

const audioPoolSounds = sounds.map((sound) => ({
  id: sound.id,
  audioUrl: sound.audioUrl
}));

const audioPoolPiece = soundPiece
  ? { id: soundPiece.id, audioUrl: soundPiece.audioUrl }
  : null;

const mapData = {
  sounds,
  paths,
  imgWidth: map.image.width,
  imgHeight: map.image.height
};
---

<Layout title={map.title}>
  <div class="flex h-screen">
    <Navigation />
    <main class="relative flex-1 overflow-hidden" transition:animate="fade">
      <div class="relative flex size-full">
        <!-- Map area wrapper: flex-1 keeps the RightRail in place during
             SSR loading. The <map-view> custom element fills this wrapper
             once it hydrates. -->
        <div class="map-wrapper relative flex flex-1 flex-col">
          <MapSkeleton />
          <map-view
            map-src={map.image.src}
            id="main-map"
            class="flex-1"
            style={`width: 100%; aspect-ratio: ${map.image.width} / ${map.image.height};`}
          >
          </map-view>
          <MapControls client:visible mapViewId="main-map" />
        </div>
        <RightRail maps={maps} activeSlug={map.slug} />
        <h2
          class="text-charcoal/60 absolute bottom-4 left-8 z-[1001] block text-3xl font-black uppercase"
          transition:name={`map-title-${map.slug}`}
        >
          {map.title}
        </h2>
      </div>

      <div class="absolute right-8 bottom-4 z-[1001]">
        <AudioBottomPlayer client:idle soundPiece={soundPiece} />
      </div>

      <AudioPool client:idle sounds={audioPoolSounds} soundPiece={audioPoolPiece} />
    </main>
  </div>
</Layout>

<script type="application/json" id="map-data" set:html={JSON.stringify(mapData)}></script>

<script>
  import '@features/maps/ui/map-view';
  import { bindMapView } from '@views/map/mapViewBindings';
  import type { MapViewElement } from '@features/maps/ui/map-view';

  const mapDataScript = document.getElementById('map-data');
  const data = mapDataScript
    ? JSON.parse(mapDataScript.textContent || '{}')
    : { sounds: [], paths: [], imgWidth: 0, imgHeight: 0 };

  const mapView = document.querySelector('map-view#main-map');
  if (!(mapView instanceof HTMLElement)) {
    console.error('<map-view id="main-map"> not found');
    throw new Error('<map-view id="main-map"> not found');
  }

  function bindWhenReady(): void {
    if (mapView.hasAttribute('data-ready')) {
      bindMapViewToElement();
      return;
    }

    const observer = new MutationObserver((mutations, obs) => {
      if (mapView.hasAttribute('data-ready')) {
        obs.disconnect();
        bindMapViewToElement();
      }
    });

    observer.observe(mapView, {
      attributes: true,
      attributeFilter: ['data-ready']
    });
  }

  function bindMapViewToElement(): void {
    bindMapView({
      mapView: mapView as MapViewElement,
      sounds: data.sounds,
      paths: data.paths,
      imgWidth: data.imgWidth,
      imgHeight: data.imgHeight
    });
  }

  bindWhenReady();
</script>

<style is:inline>
  /* Fade out the skeleton loader once <map-view> signals it is ready. */
  .map-wrapper:has(map-view[data-ready]) .map-skeleton {
    opacity: 0;
  }
</style>
