---
import RightRail from '@features/maps/ui/RightRail.astro'
import MapCompositionPreview from '@features/maps/ui/MapCompositionPreview.astro'
import { getMapDestinationPreview } from '@features/maps/lib/destinationPreview'
import HeadphonesNotice from '@features/maps/ui/HeadphonesNotice.astro'
import { AudioPool } from '@shared/lib/audio-engine'
import { AudioBottomPlayer } from '@features/sound-pieces/ui/AudioBottomPlayer.tsx'
import { MapControls } from '@features/maps/ui/MapControls.tsx'

import '@features/sounds/ui/mark-styles.css'
import '@features/sounds/ui/sound-button-styles.css'
import '@features/paths/styles/path-styles.css'
import '@features/maps/styles/map-layer-styles.css'

import type { Map } from '@features/maps/domain/types'
import type { Mark } from '@features/sounds/domain/types'
import type { Path } from '@features/paths/domain/types'
import type { SoundPiece } from '@features/sound-pieces/domain/types'

interface Props {
  map: Map
  maps: Map[]
  marks: Mark[]
  paths: Path[]
  soundPiece?: SoundPiece | null
  soundPieceEnabled?: boolean
}

const { map, maps, marks, paths, soundPiece, soundPieceEnabled = true } = Astro.props
const destinationPreview = await getMapDestinationPreview(map)

const audioPoolSounds = marks.flatMap((mark) =>
  mark.sounds.map((sound) => ({
    id: sound.id,
    audioSources: sound.audioSources
  }))
)

const audioPoolPiece =
  soundPieceEnabled && soundPiece ? { id: soundPiece.id, audioSources: soundPiece.audioSources } : null

const mapData = {
  marks,
  paths,
  imgWidth: map.images[0].width,
  imgHeight: map.images[0].height
}
---

<main class="relative max-h-dvh min-w-0 flex-1 overflow-hidden">
  <div class="relative flex size-full">
    <div class="map-wrapper relative flex min-h-0 min-w-0 flex-1 flex-col md:pointer-events-none">
      <div
        class="map-layer relative z-0 flex min-h-0 min-w-0 flex-1 flex-col md:pointer-events-auto md:fixed md:inset-0"
      >
        <MapCompositionPreview
          map={map}
          destinationPreview={destinationPreview}
          loading="eager"
          class="absolute inset-0 z-10 size-full"
          imageClass="h-full w-fit mx-auto object-contain"
        />
        <map-view
          id="main-map"
          map-layers={JSON.stringify(map.images)}
          map-title={map.title}
          render-context="active"
          class="absolute inset-0 z-20 block size-full bg-transparent"
          min-zoom='{"base":1,"md":0.8}'
          max-zoom='{"base":3.2,"md":1.5}'
        >
        </map-view>
      </div>
      <MapControls client:visible mapViewId="main-map" className="md:pointer-events-auto" />
    </div>
    <RightRail maps={maps} activeSlug={map.slug} class="shrink-0" />
  </div>

  <div
    class="pointer-events-none absolute right-4 bottom-32 left-4 z-1001 flex flex-col gap-3 md:top-4 md:right-8 md:bottom-auto md:left-8 md:flex-row md:items-end md:justify-between"
  >
    <h2
      class="block pb-4 text-center font-cormorant text-xl font-bold text-secondary-sand uppercase md:pb-0 md:text-start md:text-3xl"
      transition:name={`map-title-${map.slug}`}
    >
      {map.title}
    </h2>
    {
      soundPieceEnabled && (
        <div class="pointer-events-auto w-full max-w-2xl md:w-auto">
          <AudioBottomPlayer client:idle soundPiece={soundPiece} enabled={soundPieceEnabled} />
        </div>
      )
    }
  </div>

  <AudioPool client:idle sounds={audioPoolSounds} soundPiece={audioPoolPiece} />
</main>

<HeadphonesNotice />

<script type="application/json" id="map-data" set:html={JSON.stringify(mapData)} />

<script>
  import '@features/maps/ui/map-view'
  import { bindMapPage } from '@views/map/mapPageController'

  document.addEventListener('astro:page-load', bindMapPage)
</script>

<style is:inline>
  .map-wrapper:has(map-view[data-scene-ready]) [data-map-composition-preview] {
    opacity: 0;
    pointer-events: none;
  }

  .map-wrapper map-view,
  .map-wrapper map-view .map-world {
    background: transparent;
  }
</style>
