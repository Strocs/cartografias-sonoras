---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../shared/ui/Navigation.astro';
import RightRail from '../../features/maps/ui/RightRail.astro';
import MapSkeleton from './MapSkeleton.astro';
import { MapCanvas } from './MapCanvas.tsx';
import { AudioBottomPlayer } from '../../features/sound-pieces/ui/AudioBottomPlayer.tsx';

import type { Map } from '../../features/maps/domain/types';
import type { Sound } from '../../features/sounds/domain/types';
import type { Path } from '../../features/paths/domain/types';
import type { SoundPiece } from '../../features/sound-pieces/domain/types';

interface Props {
  map: Map;
  maps: Map[];
  sounds: Sound[];
  paths: Path[];
  soundPiece?: SoundPiece | null;
}

const { map, maps, sounds, paths, soundPiece } = Astro.props;

// Sanitize: strip non-serializable ImageMetadata before passing to client:only.
// The `asset` field (Astro ImageMetadata) contains Vite-internal references
// that cannot be serialized by Astro's devalue serializer. Passing it to a
// client:only island corrupts the entire props payload, causing the React
// component to receive malformed data and render nothing.
const mapForClient = {
  id: map.id,
  slug: map.slug,
  title: map.title,
  image: {
    src: map.image.src,
    width: map.image.width,
    height: map.image.height,
  },
  soundPieceId: map.soundPieceId,
};
---

<Layout title={map.title}>
  <div class="flex h-screen">
    <Navigation />
    <main class="relative flex-1 overflow-hidden">
      <div class="relative flex size-full">
        <!-- Map area wrapper: flex-1 keeps the RightRail in place during
             SSR loading. flex + flex-col passes height constraints down
             through the client:only island's display:contents boundary. -->
        <div class="map-wrapper relative flex flex-1 flex-col">
          <MapSkeleton />
          <MapCanvas
            client:only="react"
            map={mapForClient}
            sounds={sounds}
            paths={paths}
            soundPiece={soundPiece}
          />
        </div>
        <RightRail maps={maps} activeSlug={map.slug} />
        <h2
          class="text-charcoal/60 absolute bottom-4 left-8 z-[1001] block text-3xl font-black uppercase"
        >
          {map.title}
        </h2>
      </div>

      <div class="absolute right-8 bottom-4 z-[1001]">
        <AudioBottomPlayer client:idle soundPiece={soundPiece} />
      </div>
    </main>
  </div>
</Layout>

<style is:inline>
  /* Fade out the skeleton loader once Leaflet initializes the map.
     .leaflet-container is created by L.map() inside MapViewport. */
  .map-wrapper:has(.leaflet-container) .map-skeleton {
    opacity: 0;
  }
</style>
